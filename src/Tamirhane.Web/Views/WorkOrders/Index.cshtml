@using Tamirhane.Application.WorkOrders
@using Tamirhane.Domain.WorkOrders
@using Tamirhane.Web.Display
@model WorkOrderList
@{
    ViewData["Title"] = T["nav.work_orders"];
    var filters = new[]
    {
        WorkOrderFilter.Open, WorkOrderFilter.AwaitingApproval, WorkOrderFilter.InRepair, WorkOrderFilter.Ready,
        WorkOrderFilter.Overdue, WorkOrderFilter.Closed, WorkOrderFilter.All,
    };
    var turkey = TimeSpan.FromHours(3);
    var today = Model.Now.ToOffset(turkey).Date;
    string Waiting(WorkOrderRow row)
    {
        if (row.Status == WorkOrderStatus.Delivered && row.DeliveredAt is { } at)
            return T["list.delivered_on", at.ToOffset(turkey).ToString("d MMM")];
        if (row.Status == WorkOrderStatus.Cancelled)
            return T["list.cancelled"];
        var days = (today - row.CreatedAt.ToOffset(turkey).Date).Days;
        return days == 0 ? T["common.today"] : T["common.days", days];
    }
    bool Overdue(WorkOrderRow row) =>
        row.Status is not (WorkOrderStatus.Delivered or WorkOrderStatus.Cancelled)
        && row.CreatedAt < Model.Now.AddDays(-ListWorkOrders.OverdueDays);
    string Tone(WorkOrderStatus s) => s switch
    {
        WorkOrderStatus.Ready or WorkOrderStatus.Delivered => " stamp-ok",
        WorkOrderStatus.Cancelled or WorkOrderStatus.Declined => " stamp-warn",
        _ => "",
    };
}

<div class="page-head">
    <div>
        <h1>@T["nav.work_orders"]</h1>
        <p>@T["list.text"]</p>
    </div>
</div>

<section class="panel" aria-labelledby="list-heading">
    <div class="panel-head">
        <h2 id="list-heading" class="visually-hidden">@T["list.heading"]</h2>
        <nav class="tabs" aria-label="@T["list.filters"]">
            @foreach (var filter in filters)
            {
                <a asp-action="Index" asp-route-filter="@filter" asp-route-q="@Model.Query"
                   aria-current="@(Model.Filter == filter ? "page" : null)">@T.Of(filter)</a>
            }
        </nav>
        <form method="get" asp-action="Index" class="inline-form" role="search">
            <label for="list-search" class="visually-hidden">@T["list.search_label"]</label>
            <input id="list-search" name="q" type="search" value="@Model.Query" placeholder="@T["list.search_placeholder"]" autocomplete="off" />
            <input type="hidden" name="filter" value="@Model.Filter" />
            <button type="submit" class="btn"><svg class="icon"><use href="/img/icons.svg#i-search" /></svg>@T["list.search"]</button>
        </form>
    </div>

    @if (Model.Rows.Count == 0)
    {
        <div class="empty">
            <partial name="_EmptyHook" />
            <div>
                @if (Model.Query is { Length: > 0 })
                {
                    <h3>@T["list.no_match", Model.Query]</h3>
                    <p>@T["list.no_match_text"]@if (Model.Filter != WorkOrderFilter.All)
                    {
                        <text> @H["list.search_all_html", T.Of(Model.Filter), Url.Action("Index", new { q = Model.Query, filter = WorkOrderFilter.All })!]</text>
                    }</p>
                }
                else if (Model.Filter == WorkOrderFilter.Open)
                {
                    <h3>@T["list.empty_open"]</h3>
                    <p>@H["list.empty_open_text_html", Url.Action("New")!]</p>
                }
                else
                {
                    <h3>@T["list.empty_filter"]</h3>
                    <p><a asp-action="Index">@T["list.back_to_open"]</a></p>
                }
            </div>
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="data-table work-list">
                <thead>
                    <tr>
                        <th scope="col">@T["table.number"]</th>
                        <th scope="col">@T["table.device"]</th>
                        <th scope="col">@T["table.issue"]</th>
                        <th scope="col">@T["table.customer"]</th>
                        <th scope="col">@T["table.status"]</th>
                        <th scope="col" class="num">@T["table.waiting"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        var late = Overdue(row);
                        <tr>
                            <td class="c-no"><a class="work-no" asp-action="Details" asp-route-id="@row.Id">@row.Number</a></td>
                            <td class="c-device">@row.Brand @row.Model</td>
                            <td class="c-issue clip">@row.Complaint</td>
                            <td class="c-customer">@row.CustomerName</td>
                            <td class="c-status"><span class="stamp stamp-sm@(late ? " stamp-warn" : Tone(row.Status))">@T.Of(row.Status)</span></td>
                            <td class="c-wait num@(late ? " warn-text" : "")">@Waiting(row)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model.Truncated)
        {
            <p class="panel-foot">@T["list.truncated", ListWorkOrders.Limit]</p>
        }
    }
</section>
