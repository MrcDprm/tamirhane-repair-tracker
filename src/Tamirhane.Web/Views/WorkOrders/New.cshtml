@using Tamirhane.Web.Display
@model IntakePage
@{
    ViewData["Title"] = "Cihaz kabul et";
    var customer = Model.Customer;
}

<div class="page-head">
    <div>
        <h1>Cihaz kabul et</h1>
        @if (!Model.Searched)
        {
            <p>Önce müşterinin telefonu: kayıtlıysa bilgileri ve cihazları gelir, değilse yeni müşteri olarak kaydedersin.</p>
        }
        else if (customer is null)
        {
            <p>@Model.Input.Phone numarasıyla kayıtlı müşteri yok; yeni müşteri olarak kaydedilecek. <a asp-action="New">Başka bir telefonla ara</a></p>
        }
        else
        {
            <p>Kayıtlı müşteri: <strong>@customer.Name</strong>, @Labels.Phone(customer.Phone). <a asp-action="New">Başka bir telefonla ara</a></p>
        }
    </div>
</div>

@if (!Model.Searched)
{
    @* 1. adım: telefonla müşteri arama. Aynı numarayla gelen müşteri tekrar yazılmaz. *@
    <section class="panel narrow">
        <form class="panel-body" method="get" asp-action="New" novalidate>
            <div class="field">
                <label for="phone">Müşterinin telefonu</label>
                <div class="inline-form">
                    <div class="grow">
                        <input id="phone" name="phone" type="tel" inputmode="tel" value="@Model.Input.Phone" autocomplete="off" autofocus
                               placeholder="0532 123 45 67" />
                    </div>
                    <button type="submit" class="btn btn-primary"><svg class="icon"><use href="/img/icons.svg#i-search" /></svg>Müşteriyi bul</button>
                </div>
                @Html.ValidationMessage("Input.Phone")
            </div>
        </form>
    </section>
}
else
{
    <form method="post" asp-action="New" novalidate class="intake" id="intake-form">
        <div>
            <div asp-validation-summary="ModelOnly" class="notice notice-error" role="alert"></div>
            <input asp-for="Input.Phone" type="hidden" />
            <input asp-for="Input.CustomerId" type="hidden" />

            @if (customer is null)
            {
                <fieldset class="panel">
                    <legend class="visually-hidden">Müşteri</legend>
                    <div class="panel-head"><h2 aria-hidden="true"><span class="step">1</span>Müşteri</h2></div>
                    <div class="panel-body">
                        <div class="field-row">
                            <div class="field">
                                <label asp-for="Input.CustomerName"></label>
                                <input asp-for="Input.CustomerName" autocomplete="off" data-preview="customer" />
                                <span asp-validation-for="Input.CustomerName"></span>
                            </div>
                            <div class="field">
                                <label asp-for="Input.CustomerEmail"></label>
                                <input asp-for="Input.CustomerEmail" type="email" autocomplete="off" aria-describedby="email-help" />
                                <div id="email-help" class="field-help">Yazılırsa durum değiştikçe müşteriye e-posta gider.</div>
                                <span asp-validation-for="Input.CustomerEmail"></span>
                            </div>
                        </div>
                        <div class="check">
                            <input asp-for="Input.KvkkConsent" />
                            <label asp-for="Input.KvkkConsent"></label>
                        </div>
                        <span asp-validation-for="Input.KvkkConsent"></span>
                    </div>
                </fieldset>
            }

            <fieldset class="panel">
                <legend class="visually-hidden">Cihaz</legend>
                <div class="panel-head"><h2 aria-hidden="true"><span class="step">@(customer is null ? 2 : 1)</span>Cihaz</h2></div>
                <div class="panel-body">
                    @if (customer is { Devices.Count: > 0 })
                    {
                        <p class="muted">Müşterinin kayıtlı cihazlarından birini seç ya da yeni cihaz ekle.</p>
                        @foreach (var device in customer.Devices)
                        {
                            <div class="check">
                                <input type="radio" id="device-@device.Id" name="Input.DeviceId" value="@device.Id" checked="@(Model.Input.DeviceId == device.Id)"
                                       data-device="@device.Brand @device.Model" />
                                <label for="device-@device.Id">
                                    @device.Brand @device.Model <span class="muted">(@Labels.Of(device.Kind))</span>
                                    @if (device.Imei is not null)
                                    {
                                        <span class="muted">IMEI <code>@device.Imei</code></span>
                                    }
                                </label>
                            </div>
                        }
                        <div class="check">
                            <input type="radio" id="device-new" name="Input.DeviceId" value="" checked="@(Model.Input.DeviceId is null)" />
                            <label for="device-new">Yeni cihaz (aşağıya yaz)</label>
                        </div>
                    }
                    <div class="field-row">
                        <div class="field">
                            <label asp-for="Input.DeviceKind"></label>
                            <select asp-for="Input.DeviceKind">
                                @foreach (var (kind, label) in Labels.DeviceKinds)
                                {
                                    <option value="@kind" selected="@(Model.Input.DeviceKind == kind)">@label</option>
                                }
                            </select>
                            <span asp-validation-for="Input.DeviceKind"></span>
                        </div>
                        <div class="field">
                            <label asp-for="Input.Brand"></label>
                            <input asp-for="Input.Brand" autocomplete="off" placeholder="ör. Apple" data-preview="brand" />
                            <span asp-validation-for="Input.Brand"></span>
                        </div>
                        <div class="field">
                            <label asp-for="Input.Model"></label>
                            <input asp-for="Input.Model" autocomplete="off" placeholder="ör. iPhone 13" data-preview="model" />
                            <span asp-validation-for="Input.Model"></span>
                        </div>
                    </div>
                    <div class="field-row">
                        <div class="field">
                            <label asp-for="Input.Imei"></label>
                            <input asp-for="Input.Imei" inputmode="numeric" autocomplete="off" class="code" aria-describedby="imei-help" data-preview="imei" />
                            <div id="imei-help" class="field-help">Telefonda *#06# tuşlayınca görünür.</div>
                            <span asp-validation-for="Input.Imei"></span>
                        </div>
                        <div class="field">
                            <label asp-for="Input.Serial"></label>
                            <input asp-for="Input.Serial" autocomplete="off" class="code" />
                            <span asp-validation-for="Input.Serial"></span>
                        </div>
                    </div>
                </div>
            </fieldset>

            <fieldset class="panel">
                <legend class="visually-hidden">Arıza ve teslim alınanlar</legend>
                <div class="panel-head"><h2 aria-hidden="true"><span class="step">@(customer is null ? 3 : 2)</span>Arıza ve teslim alınanlar</h2></div>
                <div class="panel-body">
                    <div class="field">
                        <label asp-for="Input.Complaint"></label>
                        <textarea asp-for="Input.Complaint" rows="3" placeholder="ör. Ekran kırık, dokunmatik sağ altta çalışmıyor" data-preview="complaint"></textarea>
                        <span asp-validation-for="Input.Complaint"></span>
                    </div>
                    <div class="field">
                        <label asp-for="Input.Condition"></label>
                        <textarea asp-for="Input.Condition" rows="2" placeholder="ör. Kasada çizik, arka cam sağlam"></textarea>
                        <span asp-validation-for="Input.Condition"></span>
                    </div>
                    <div class="field-row">
                        <div class="field">
                            <label asp-for="Input.Accessories"></label>
                            <input asp-for="Input.Accessories" autocomplete="off" placeholder="ör. Kılıf, şarj aleti" data-preview="accessories" />
                            <span asp-validation-for="Input.Accessories"></span>
                        </div>
                        <div class="field">
                            <label asp-for="Input.Passcode"></label>
                            <input asp-for="Input.Passcode" autocomplete="off" spellcheck="false" aria-describedby="passcode-help" />
                            <div id="passcode-help" class="field-help">Sadece onarım için gerekiyorsa. İş emri kapanınca silinir, fişte ve takip sayfasında görünmez.</div>
                            <span asp-validation-for="Input.Passcode"></span>
                        </div>
                    </div>
                </div>
            </fieldset>

            <button type="submit" class="btn btn-primary"><svg class="icon"><use href="/img/icons.svg#i-tag" /></svg>Cihazı kabul et</button>
        </div>

        @* Etiket önizlemesi: yazdıkça dolar (intake.js); kaydedince numara ve kaşe basılır. Ekran okuyucu formu zaten okur. *@
        <aside class="intake-preview" aria-hidden="true">
            <p>Yazdıkça etiket doluyor; kaydedince numara ve kaşe basılır.</p>
            <div class="ticket">
                <span class="work-no is-empty">Yeni iş emri</span>
                <dl>
                    <dt>Müşteri</dt><dd data-show="customer">@(customer?.Name ?? (string.IsNullOrWhiteSpace(Model.Input.CustomerName) ? "" : Model.Input.CustomerName))</dd>
                    <dt>Telefon</dt><dd>@Labels.Phone(customer?.Phone ?? Model.Input.Phone)</dd>
                    <dt>Cihaz</dt><dd data-show="device"></dd>
                    <dt>IMEI</dt><dd data-show="imei" class="code"></dd>
                    <dt>Şikâyet</dt><dd data-show="complaint"></dd>
                    <dt>Aksesuar</dt><dd data-show="accessories"></dd>
                </dl>
            </div>
        </aside>
    </form>
}

@section Scripts {
    <script src="~/js/intake.js" asp-append-version="true"></script>
}
