@using Tamirhane.Web.Display
@model IntakePage
@{
    ViewData["Title"] = T["intake.title"];
    var customer = Model.Customer;
}

<div class="page-head">
    <div>
        <h1>@T["intake.title"]</h1>
        @if (!Model.Searched)
        {
            <p>@T["intake.text"]</p>
        }
        else if (customer is null)
        {
            <p>@T["intake.new_customer", Model.Input.Phone] <a asp-action="New">@T["intake.other_phone"]</a></p>
        }
        else
        {
            <p>@H["intake.known_customer_html", customer.Name, Labels.Phone(customer.Phone)] <a asp-action="New">@T["intake.other_phone"]</a></p>
        }
    </div>
</div>

@if (!Model.Searched)
{
    @* 1. adım: telefonla müşteri arama. Aynı numarayla gelen müşteri tekrar yazılmaz. *@
    <section class="panel narrow">
        <form class="panel-body" method="get" asp-action="New" novalidate>
            <div class="field">
                <label for="phone">@T["intake.phone"]</label>
                <div class="inline-form">
                    <div class="grow">
                        <input id="phone" name="phone" type="tel" inputmode="tel" value="@Model.Input.Phone" autocomplete="off" autofocus
                               placeholder="0532 123 45 67" />
                    </div>
                    <button type="submit" class="btn btn-primary"><svg class="icon"><use href="/img/icons.svg#i-search" /></svg>@T["intake.find"]</button>
                </div>
                @Html.ValidationMessage("Input.Phone")
            </div>
        </form>
    </section>
}
else
{
    <form method="post" asp-action="New" novalidate class="intake" id="intake-form">
        <div>
            <div asp-validation-summary="ModelOnly" class="notice notice-error" role="alert"></div>
            <input asp-for="Input.Phone" type="hidden" />
            <input asp-for="Input.CustomerId" type="hidden" />

            @if (customer is null)
            {
                <fieldset class="panel">
                    <legend class="visually-hidden">@T["table.customer"]</legend>
                    <div class="panel-head"><h2 aria-hidden="true"><span class="step">1</span>@T["table.customer"]</h2></div>
                    <div class="panel-body">
                        <div class="field-row">
                            <div class="field">
                                <label asp-for="Input.CustomerName"></label>
                                <input asp-for="Input.CustomerName" autocomplete="off" data-preview="customer" />
                                <span asp-validation-for="Input.CustomerName"></span>
                            </div>
                            <div class="field">
                                <label asp-for="Input.CustomerEmail"></label>
                                <input asp-for="Input.CustomerEmail" type="email" autocomplete="off" aria-describedby="email-help" />
                                <div id="email-help" class="field-help">@T["intake.email_help"]</div>
                                <span asp-validation-for="Input.CustomerEmail"></span>
                            </div>
                        </div>
                        <div class="check">
                            <input asp-for="Input.KvkkConsent" />
                            <label asp-for="Input.KvkkConsent"></label>
                        </div>
                        <span asp-validation-for="Input.KvkkConsent"></span>
                    </div>
                </fieldset>
            }

            <fieldset class="panel">
                <legend class="visually-hidden">@T["table.device"]</legend>
                <div class="panel-head"><h2 aria-hidden="true"><span class="step">@(customer is null ? 2 : 1)</span>@T["table.device"]</h2></div>
                <div class="panel-body">
                    @if (customer is { Devices.Count: > 0 })
                    {
                        <p class="muted">@T["intake.pick_device"]</p>
                        @foreach (var device in customer.Devices)
                        {
                            <div class="check">
                                <input type="radio" id="device-@device.Id" name="Input.DeviceId" value="@device.Id" checked="@(Model.Input.DeviceId == device.Id)"
                                       data-device="@device.Brand @device.Model" />
                                <label for="device-@device.Id">
                                    @device.Brand @device.Model <span class="muted">(@T.Of(device.Kind))</span>
                                    @if (device.Imei is not null)
                                    {
                                        <span class="muted">IMEI <code>@device.Imei</code></span>
                                    }
                                </label>
                            </div>
                        }
                        <div class="check">
                            <input type="radio" id="device-new" name="Input.DeviceId" value="" checked="@(Model.Input.DeviceId is null)" />
                            <label for="device-new">@T["intake.new_device"]</label>
                        </div>
                    }
                    <div class="field-row">
                        <div class="field">
                            <label asp-for="Input.DeviceKind"></label>
                            <select asp-for="Input.DeviceKind">
                                @foreach (var kind in Labels.DeviceKinds)
                                {
                                    <option value="@kind" selected="@(Model.Input.DeviceKind == kind)">@T.Of(kind)</option>
                                }
                            </select>
                            <span asp-validation-for="Input.DeviceKind"></span>
                        </div>
                        <div class="field">
                            <label asp-for="Input.Brand"></label>
                            <input asp-for="Input.Brand" autocomplete="off" placeholder="@T["intake.brand_example"]" data-preview="brand" />
                            <span asp-validation-for="Input.Brand"></span>
                        </div>
                        <div class="field">
                            <label asp-for="Input.Model"></label>
                            <input asp-for="Input.Model" autocomplete="off" placeholder="@T["intake.model_example"]" data-preview="model" />
                            <span asp-validation-for="Input.Model"></span>
                        </div>
                    </div>
                    <div class="field-row">
                        <div class="field">
                            <label asp-for="Input.Imei"></label>
                            <input asp-for="Input.Imei" inputmode="numeric" autocomplete="off" class="code" aria-describedby="imei-help" data-preview="imei" />
                            <div id="imei-help" class="field-help">@T["intake.imei_help"]</div>
                            <span asp-validation-for="Input.Imei"></span>
                        </div>
                        <div class="field">
                            <label asp-for="Input.Serial"></label>
                            <input asp-for="Input.Serial" autocomplete="off" class="code" />
                            <span asp-validation-for="Input.Serial"></span>
                        </div>
                    </div>
                </div>
            </fieldset>

            <fieldset class="panel">
                <legend class="visually-hidden">@T["intake.issue"]</legend>
                <div class="panel-head"><h2 aria-hidden="true"><span class="step">@(customer is null ? 3 : 2)</span>@T["intake.issue"]</h2></div>
                <div class="panel-body">
                    <div class="field">
                        <label asp-for="Input.Complaint"></label>
                        <textarea asp-for="Input.Complaint" rows="3" placeholder="@T["intake.complaint_example"]" data-preview="complaint"></textarea>
                        <span asp-validation-for="Input.Complaint"></span>
                    </div>
                    <div class="field">
                        <label asp-for="Input.Condition"></label>
                        <textarea asp-for="Input.Condition" rows="2" placeholder="@T["intake.condition_example"]"></textarea>
                        <span asp-validation-for="Input.Condition"></span>
                    </div>
                    <div class="field-row">
                        <div class="field">
                            <label asp-for="Input.Accessories"></label>
                            <input asp-for="Input.Accessories" autocomplete="off" placeholder="@T["intake.accessories_example"]" data-preview="accessories" />
                            <span asp-validation-for="Input.Accessories"></span>
                        </div>
                        <div class="field">
                            <label asp-for="Input.Passcode"></label>
                            <input asp-for="Input.Passcode" autocomplete="off" spellcheck="false" aria-describedby="passcode-help" />
                            <div id="passcode-help" class="field-help">@T["intake.passcode_help"]</div>
                            <span asp-validation-for="Input.Passcode"></span>
                        </div>
                        <div class="field">
                            <label asp-for="Input.PromisedDate"></label>
                            <input asp-for="Input.PromisedDate" type="date" aria-describedby="promise-help" />
                            <div id="promise-help" class="field-help">@T["intake.promise_help"]</div>
                            <span asp-validation-for="Input.PromisedDate"></span>
                        </div>
                    </div>
                </div>
            </fieldset>

            <button type="submit" class="btn btn-primary"><svg class="icon"><use href="/img/icons.svg#i-tag" /></svg>@T["intake.submit"]</button>
        </div>

        @* Etiket önizlemesi: yazdıkça dolar (intake.js); kaydedince numara ve kaşe basılır. Ekran okuyucu formu zaten okur. *@
        <aside class="intake-preview" aria-hidden="true">
            <p>@T["intake.preview"]</p>
            <div class="ticket">
                <span class="work-no is-empty">@T["intake.preview_number"]</span>
                <dl>
                    <dt>@T["table.customer"]</dt><dd data-show="customer" data-empty="@T["intake.preview_customer"]">@(customer?.Name ?? (string.IsNullOrWhiteSpace(Model.Input.CustomerName) ? "" : Model.Input.CustomerName))</dd>
                    <dt>@T["field.phone"]</dt><dd>@Labels.Phone(customer?.Phone ?? Model.Input.Phone)</dd>
                    <dt>@T["table.device"]</dt><dd data-show="device" data-empty="@T["intake.preview_device"]"></dd>
                    <dt>IMEI</dt><dd data-show="imei" data-empty="@T["intake.preview_none"]" class="code"></dd>
                    <dt>@T["intake.preview_complaint_label"]</dt><dd data-show="complaint" data-empty="@T["intake.preview_complaint"]"></dd>
                    <dt>@T["intake.preview_accessories_label"]</dt><dd data-show="accessories" data-empty="@T["intake.preview_none"]"></dd>
                </dl>
            </div>
        </aside>
    </form>
}

@section Scripts {
    <script src="~/js/intake.js" asp-append-version="true"></script>
}
