@using System.Globalization
@using Tamirhane.Application.WorkOrders
@using Tamirhane.Domain.WorkOrders
@model WorkOrderView
@{
    var lines = Model.QuoteLines;
    var totals = Model.QuoteTotals;
    var vat = Model.DefaultVatRate.ToString("0.##", CultureInfo.InvariantCulture);
    string Percent(decimal value) => "%" + value.ToString("0.##");
}

@* Teklif: kalemler, sunucuda hesaplanan toplamlar; düzenlenebilirken kalem ekleme ve silme (htmx ile yerinde). *@
<section class="panel quote" aria-labelledby="quote-heading">
    <div class="panel-head">
        <h2 id="quote-heading">Teklif</h2>
        @if (Model.QuoteDecision is { } decision)
        {
            <span class="stamp stamp-sm@(decision.Kind == QuoteDecisionKind.Approved ? " stamp-ok" : " stamp-warn")">
                @(decision.Kind == QuoteDecisionKind.Approved ? "Onaylandı" : "Reddedildi")
            </span>
        }
        else if (Model.Status == WorkOrderStatus.AwaitingApproval)
        {
            <span class="muted">Müşterinin onayı bekleniyor; teklif kilitli.</span>
        }
    </div>

    @if (lines.Count == 0 && !Model.IsQuoteEditable)
    {
        <p class="panel-body muted">
            @(Model.Status == WorkOrderStatus.Received
                ? "Teklif, incelemeye başlayınca hazırlanır."
                : "Bu iş emrinde teklif yok.")
        </p>
    }

    @if (lines.Count > 0)
    {
        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th scope="col">Kalem</th>
                        <th scope="col" class="num">Miktar</th>
                        <th scope="col" class="num">Birim fiyat</th>
                        <th scope="col" class="num">İskonto</th>
                        <th scope="col" class="num">KDV</th>
                        <th scope="col" class="num">Tutar</th>
                        @if (Model.IsQuoteEditable)
                        {
                            <th scope="col"><span class="visually-hidden">İşlem</span></th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var line in lines)
                    {
                        <tr>
                            <td>
                                @line.Description
                                <span class="muted small">@(line.Kind == QuoteLineKind.Labor ? "işçilik" : line.FromStock ? "stoktan" : "stok dışı parça")</span>
                            </td>
                            <td class="num">@line.Quantity.ToString("0.##")</td>
                            <td class="num">@line.UnitPrice.ToString("C")</td>
                            <td class="num">@(line.DiscountRate == 0 ? "" : Percent(line.DiscountRate))</td>
                            <td class="num">@Percent(line.VatRate)</td>
                            <td class="num"><strong>@line.Total.ToString("C")</strong></td>
                            @if (Model.IsQuoteEditable)
                            {
                                <td class="actions">
                                    <form method="post" asp-action="RemoveLine" asp-route-id="@Model.Id" asp-route-lineId="@line.Id"
                                          hx-post="/work-orders/@Model.Id/quote-lines/@line.Id/remove" hx-target="#work-order" hx-swap="outerHTML">
                                        <button type="submit" class="btn btn-danger" aria-label="@line.Description kalemini çıkar">Çıkar</button>
                                    </form>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <dl class="quote-totals">
            <dt>Ara toplam</dt><dd>@totals.Gross.ToString("C")</dd>
            @if (totals.Discount > 0)
            {
                <dt>İskonto</dt><dd>−@totals.Discount.ToString("C")</dd>
            }
            <dt>KDV</dt><dd>@totals.Vat.ToString("C")</dd>
            <dt class="grand">Genel toplam</dt><dd class="grand">@totals.Total.ToString("C")</dd>
        </dl>
    }

    @if (Model.IsQuoteEditable)
    {
        <div class="quote-add">
            <form method="post" asp-action="AddLine" asp-route-id="@Model.Id"
                  hx-post="/work-orders/@Model.Id/quote-lines" hx-target="#work-order" hx-swap="outerHTML">
                <h3>Stoktan parça ekle</h3>
                <input type="hidden" name="Kind" value="@QuoteLineKind.Part" />
                @if (Model.PartOptions.Count == 0)
                {
                    <p class="muted">Bu şubenin stoğunda henüz parça yok. Stokta olmayan parçayı yandaki formdan "stok dışı parça" olarak ekleyebilirsin.</p>
                }
                else
                {
                    <div class="field">
                        <label for="quote-part">Parça</label>
                        <select id="quote-part" name="PartId" required>
                            @foreach (var option in Model.PartOptions)
                            {
                                <option value="@option.Id">@option.Name (@option.Sku), stokta @option.Quantity, @option.SalePrice.ToString("C")</option>
                            }
                        </select>
                    </div>
                    <div class="field-row">
                        <div class="field">
                            <label for="part-qty">Adet</label>
                            <input id="part-qty" name="Quantity" type="number" min="1" step="1" value="1" inputmode="numeric" />
                        </div>
                        <div class="field">
                            <label for="part-price">Birim fiyat</label>
                            <input id="part-price" name="UnitPrice" type="number" min="0" step="0.01" inputmode="decimal" placeholder="satış fiyatı" />
                        </div>
                        <div class="field">
                            <label for="part-discount">İskonto %</label>
                            <input id="part-discount" name="DiscountRate" type="number" min="0" max="100" step="0.01" value="0" inputmode="decimal" />
                        </div>
                        <div class="field">
                            <label for="part-vat">KDV %</label>
                            <input id="part-vat" name="VatRate" type="number" min="0" max="100" step="0.01" value="@vat" inputmode="decimal" />
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary"><svg class="icon"><use href="/img/icons.svg#i-plus" /></svg>Parçayı ekle</button>
                }
            </form>

            <form method="post" asp-action="AddLine" asp-route-id="@Model.Id"
                  hx-post="/work-orders/@Model.Id/quote-lines" hx-target="#work-order" hx-swap="outerHTML">
                <h3>İşçilik ya da serbest kalem ekle</h3>
                <div class="field-row">
                    <div class="field">
                        <label for="free-kind">Tür</label>
                        <select id="free-kind" name="Kind">
                            <option value="@QuoteLineKind.Labor">İşçilik</option>
                            <option value="@QuoteLineKind.Part">Stok dışı parça (sipariş)</option>
                        </select>
                    </div>
                    <div class="field">
                        <label for="free-desc">Açıklama</label>
                        <input id="free-desc" name="Description" maxlength="200" placeholder="ör. Ekran değişimi işçiliği" autocomplete="off" />
                    </div>
                </div>
                <div class="field-row">
                    <div class="field">
                        <label for="free-qty">Miktar</label>
                        <input id="free-qty" name="Quantity" type="number" min="0.01" step="0.01" value="1" inputmode="decimal" />
                    </div>
                    <div class="field">
                        <label for="free-price">Birim fiyat</label>
                        <input id="free-price" name="UnitPrice" type="number" min="0" step="0.01" inputmode="decimal" />
                    </div>
                    <div class="field">
                        <label for="free-discount">İskonto %</label>
                        <input id="free-discount" name="DiscountRate" type="number" min="0" max="100" step="0.01" value="0" inputmode="decimal" />
                    </div>
                    <div class="field">
                        <label for="free-vat">KDV %</label>
                        <input id="free-vat" name="VatRate" type="number" min="0" max="100" step="0.01" value="@vat" inputmode="decimal" />
                    </div>
                </div>
                <button type="submit" class="btn"><svg class="icon"><use href="/img/icons.svg#i-plus" /></svg>Kalemi ekle</button>
            </form>
        </div>
    }
</section>
