@model Tamirhane.Application.WorkOrders.WorkOrderView
@{
    ViewData["Title"] = Model.Number;
    // Sayfa yenilenerek gelindiyse (JavaScript yok ya da kabulden yönlendirme) bilgiler TempData'dan.
    ViewData["Created"] = TempData["Created"] is true;
    ViewData["Pressed"] = TempData["Pressed"] is true || TempData.Peek("Created") is true;
    ViewData["Error"] = TempData["Error"] as string;
}

<div class="page-head">
    <div>
        <h1>@Model.Number</h1>
        <p>@Model.Brand @Model.Model, @Model.CustomerName</p>
    </div>
    <div class="inline-form">
        @* Yazdırma sayfası #26'da. *@
        <a class="btn" href="/work-orders/@Model.Id/receipt"><svg class="icon"><use href="/img/icons.svg#i-printer" /></svg>Fişi yazdır</a>
    </div>
</div>

<partial name="_WorkOrderBody" model="Model" />
