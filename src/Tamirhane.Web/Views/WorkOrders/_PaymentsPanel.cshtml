@using System.Globalization
@using Tamirhane.Application.WorkOrders
@using Tamirhane.Domain.WorkOrders
@model WorkOrderView
@{
    var turkey = TimeSpan.FromHours(3);
    var isOwner = User.IsInRole("Owner");
    var declined = Model.QuoteDecision?.Kind == QuoteDecisionKind.Declined;
    string Method(PaymentMethod m) => m switch
    {
        PaymentMethod.Cash => T["payment.cash"],
        PaymentMethod.Card => T["payment.card"],
        PaymentMethod.Transfer => T["payment.transfer"],
        _ => m.ToString(),
    };
    // "Nakit, Kapora" ya da "iade (Havale), Kapora geri": tek parça metin, Razor boşluk eklemesin.
    string Describe(PaymentView p) =>
        (p.Kind == PaymentKind.Refund ? T["payment.refund_of", Method(p.Method)] : Method(p.Method)) + (p.Note is null ? "" : $", {p.Note}");
        string Plain(decimal value) => value.ToString("0.##", CultureInfo.InvariantCulture);
}

@* Tahsilat: para sistemden geçmez, bu kasanın kaydıdır. Tutarları domain hesaplar. *@
<section class="panel" aria-labelledby="payments-heading">
    <div class="panel-head"><h2 id="payments-heading">@T["payment.title"]</h2></div>
    <dl class="panel-body money">
        <dt>@T[declined ? "payment.diagnosis_fee" : "payment.quote_total"]</dt><dd>@Model.AmountDue.ToString("C")</dd>
        <dt>@T["payment.paid"]</dt><dd>@Model.PaidTotal.ToString("C")</dd>
        @if (Model.Balance > 0)
        {
            <dt>@T["payment.balance"]</dt><dd class="warn-text">@Model.Balance.ToString("C")</dd>
        }
        else if (Model.Balance < 0)
        {
            <dt>@T["payment.overpaid"]</dt><dd class="warn-text">@T["payment.overpaid_amount", -Model.Balance]</dd>
        }
        else if (Model.AmountDue > 0)
        {
            <dt>@T["payment.balance"]</dt><dd><span class="stamp stamp-sm stamp-ok">@T["payment.settled"]</span></dd>
        }
        @if (Model.BalanceAtDelivery is { } debt)
        {
            <dt>@T["payment.delivered_with_balance"]</dt><dd class="warn-text">@debt.ToString("C")</dd>
        }
    </dl>

    @if (Model.CanSetDiagnosisFee)
    {
        <form method="post" asp-action="DiagnosisFee" asp-route-id="@Model.Id" class="panel-body inline-form bordered"
              hx-post="/work-orders/@Model.Id/diagnosis-fee" hx-target="#work-order" hx-swap="outerHTML">
            <div class="grow">
                <label for="diagnosis-fee">@T["payment.diagnosis_fee_label"]</label>
                <input id="diagnosis-fee" name="fee" type="number" min="0" step="0.01" inputmode="decimal" value="@Plain(Model.DiagnosisFee)" />
            </div>
            <button type="submit" class="btn">@T["payment.diagnosis_fee_submit"]</button>
        </form>
    }

    @if (Model.CanTakePayment)
    {
        <form method="post" asp-action="Pay" asp-route-id="@Model.Id" class="panel-body bordered"
              hx-post="/work-orders/@Model.Id/payments" hx-target="#work-order" hx-swap="outerHTML">
            <fieldset class="choices">
                <legend class="label">@T["payment.method"]</legend>
                @foreach (var method in new[] { PaymentMethod.Cash, PaymentMethod.Card, PaymentMethod.Transfer })
                {
                    <label class="choice">
                        <input type="radio" name="Method" value="@method" checked="@(method == PaymentMethod.Cash)" />
                        <span>@Method(method)</span>
                    </label>
                }
            </fieldset>
            <div class="field-row">
                <div class="field">
                    <label for="pay-amount">@T["quote.amount"]</label>
                    <input id="pay-amount" name="Amount" type="number" min="0.01" step="0.01" inputmode="decimal" value="@Plain(Model.Balance)" />
                </div>
                <div class="field">
                    <label for="pay-note">@T["payment.note_optional"]</label>
                    <input id="pay-note" name="Note" maxlength="200" placeholder="@T["payment.note_example"]" autocomplete="off" />
                </div>
            </div>
            <button type="submit" class="btn btn-primary btn-block">@T["payment.submit"]</button>
        </form>
    }

    @if (Model.Payments.Count > 0)
    {
        <ul class="plain-list payments">
            @foreach (var p in Model.Payments)
            {
                <li>
                    <span>
                        <strong class="@(p.Kind == PaymentKind.Refund ? "change-minus" : "")">@(p.Kind == PaymentKind.Refund ? "−" : "")@p.Amount.ToString("C")</strong>
                        @Describe(p)
                    </span>
                    <span class="muted">@p.At.ToOffset(turkey).ToString("d MMMM HH:mm"), @p.By</span>
                </li>
            }
        </ul>
    }

    @if (isOwner && Model.CanRefund)
    {
        <details class="cancel panel-body">
            <summary>@T["payment.refund"]</summary>
            <form method="post" asp-action="Refund" asp-route-id="@Model.Id"
                  hx-post="/work-orders/@Model.Id/refunds" hx-target="#work-order" hx-swap="outerHTML">
                <div class="field-row">
                    <div class="field">
                        <label for="refund-amount">@T["quote.amount"]</label>
                        <input id="refund-amount" name="Amount" type="number" min="0.01" step="0.01" inputmode="decimal" />
                    </div>
                    <div class="field">
                        <label for="refund-method">@T["payment.refund_method"]</label>
                        <select id="refund-method" name="Method">
                            @foreach (var method in new[] { PaymentMethod.Cash, PaymentMethod.Card, PaymentMethod.Transfer })
                            {
                                <option value="@method">@Method(method)</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="field">
                    <label for="refund-note">@T["payment.note"]</label>
                    <input id="refund-note" name="Note" maxlength="200" placeholder="@T["payment.refund_note_example"]" autocomplete="off" />
                </div>
                <button type="submit" class="btn btn-danger">@T["payment.refund_submit"]</button>
            </form>
        </details>
    }
</section>
