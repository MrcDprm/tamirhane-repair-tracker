@using Tamirhane.Application.WorkOrders
@using Tamirhane.Domain.WorkOrders
@using Tamirhane.Web.Display
@model WorkOrderView
@{
    // İşlemden sonra htmx sadece bu bölümü değiştirir; son kaşe "basılır" (motion.js).
    var pressed = ViewData["Pressed"] is true;
    var created = ViewData["Created"] is true;
    var error = ViewData["Error"] as string;
    var success = ViewData["Success"] as string;
    var turkey = TimeSpan.FromHours(3);
    var next = Model.NextAction;
    var others = Model.Actions.Where(a => a != next && a != WorkOrderAction.Cancel).ToList();
    var stamps = Model.History.Select(h => h.Status).ToList();
    var workshopNotes = Model.Notes.Where(n => !n.VisibleToCustomer).ToList();
    var customerNotes = Model.Notes.Where(n => n.VisibleToCustomer).ToList();
    string Hx(string path) => $"/work-orders/{Model.Id}/{path}";
}

<div id="work-order">
    @if (error is not null)
    {
        <div class="notice notice-error" role="alert">@error</div>
    }
    else if (success is not null)
    {
        <div class="notice notice-ok" role="status">@success</div>
    }
    else if (created)
    {
        <div class="notice notice-ok" role="status">@T["workorder.created", Model.Number]</div>
    }
    else if (pressed)
    {
        <div class="notice notice-ok" role="status">@T["workorder.status_updated", T.Of(Model.Status)]</div>
    }

    @if (Model.WarrantyOf is { } previous)
    {
        <p class="notice notice-ok">@H["workorder.warranty_of_html", Url.Action("Details", new { id = previous.Id })!, previous.Number]</p>
    }

    <div class="work-layout">
        <article class="ticket" aria-label="@T["workorder.ticket"]">
            <span class="work-no">@Model.Number</span>
            <dl>
                <dt>@T["table.customer"]</dt><dd>@Model.CustomerName</dd>
                <dt>@T["table.device"]</dt><dd>@Model.Brand @Model.Model <span class="is-empty">(@T.Of(Model.DeviceKind))</span></dd>
                @if (Model.Imei is not null)
                {
                    <dt>IMEI</dt><dd><code>@Model.Imei</code></dd>
                }
                @if (Model.Serial is not null)
                {
                    <dt>@T["workorder.serial"]</dt><dd><code>@Model.Serial</code></dd>
                }
                <dt>@T["intake.preview_complaint_label"]</dt><dd>@Model.Complaint</dd>
                @if (Model.Condition is not null)
                {
                    <dt>@T["workorder.condition"]</dt><dd>@Model.Condition</dd>
                }
                @if (Model.Accessories is not null)
                {
                    <dt>@T["intake.preview_accessories_label"]</dt><dd>@Model.Accessories</dd>
                }
                @if (Model.PromisedDate is { } promised)
                {
                    <dt>@T["workorder.promised"]</dt><dd>@promised.ToString(T["format.day"])</dd>
                }
            </dl>
            @* Geçilen her durum etikete bir kaşe; sonuncusu az önce basıldıysa hareketle gelir. *@
            <p class="ticket-stamps" aria-label="@T["workorder.stamps"]">
                @for (var i = 0; i < stamps.Count; i++)
                {
                    var last = i == stamps.Count - 1;
                    var tone = stamps[i] is WorkOrderStatus.Cancelled or WorkOrderStatus.Declined ? " stamp-warn"
                        : stamps[i] is WorkOrderStatus.Ready or WorkOrderStatus.Delivered ? " stamp-ok" : "";
                    <span class="stamp@(tone)@(last ? " is-current" : "")@(last && pressed ? " is-pressed" : "")">@T.Of(stamps[i])</span>
                }
            </p>
        </article>

        <div>
            @if (Model.Actions.Count > 0)
            {
                <section class="panel" aria-labelledby="next-heading">
                    <div class="panel-head"><h2 id="next-heading">@T["workorder.next_step"]</h2></div>
                    <div class="panel-body">
                        @if (next is WorkOrderAction.RecordApproval)
                        {
                            @* Müşteri kararını telefonla bildirdi; personel onun adına kaydeder. *@
                            <form method="post" asp-action="Step" asp-route-id="@Model.Id" hx-post="@Hx("steps")" hx-target="#work-order" hx-swap="outerHTML">
                                <div class="field">
                                    <label for="decided-by">@T["workorder.decided_by"]</label>
                                    <input id="decided-by" name="DecidedBy" value="@Model.CustomerName" maxlength="100" autocomplete="off" />
                                </div>
                                <div class="inline-form">
                                    <button type="submit" name="Step" value="@WorkOrderAction.RecordApproval" class="btn btn-primary">@T.Of(WorkOrderAction.RecordApproval)</button>
                                    <button type="submit" name="Step" value="@WorkOrderAction.RecordDecline" class="btn">@T.Of(WorkOrderAction.RecordDecline)</button>
                                </div>
                            </form>
                        }
                        else if (next is { } step)
                        {
                            <form method="post" asp-action="Step" asp-route-id="@Model.Id" hx-post="@Hx("steps")" hx-target="#work-order" hx-swap="outerHTML">
                                @if (step == WorkOrderAction.Deliver && Model.Balance > 0)
                                {
                                    <p class="warn-text">@T["workorder.balance_due", Model.Balance]</p>
                                    @if (User.IsInRole("Owner"))
                                    {
                                        <div class="check">
                                            <input type="checkbox" id="allow-balance" name="AllowBalanceDue" value="true" />
                                            <label for="allow-balance">@T["workorder.allow_balance"]</label>
                                        </div>
                                    }
                                }
                                <button type="submit" name="Step" value="@step" class="btn btn-primary btn-block">@T.Of(step)</button>
                            </form>
                            @foreach (var other in others)
                            {
                                <form method="post" asp-action="Step" asp-route-id="@Model.Id" hx-post="@Hx("steps")" hx-target="#work-order" hx-swap="outerHTML" class="other-step">
                                    <button type="submit" name="Step" value="@other" class="btn btn-block">@T.Of(other)</button>
                                </form>
                            }
                        }

                        @if (Model.Actions.Contains(WorkOrderAction.Cancel))
                        {
                            <details class="cancel">
                                <summary>@T.Of(WorkOrderAction.Cancel)</summary>
                                <form method="post" asp-action="Step" asp-route-id="@Model.Id" hx-post="@Hx("steps")" hx-target="#work-order" hx-swap="outerHTML">
                                    <div class="field">
                                        <label for="cancel-reason">@T["workorder.cancel_reason"]</label>
                                        <textarea id="cancel-reason" name="Reason" rows="2" maxlength="1000" placeholder="@T["workorder.cancel_example"]"></textarea>
                                    </div>
                                    <button type="submit" name="Step" value="@WorkOrderAction.Cancel" class="btn btn-danger">@T["workorder.cancel_submit"]</button>
                                </form>
                            </details>
                        }
                    </div>
                </section>
            }
            else if (Model.Status == WorkOrderStatus.Delivered)
            {
                <section class="panel panel-body">
                    <p>@T["workorder.delivered"]
                        @if (Model.WarrantyUntil is { } until)
                        {
                            @T["workorder.warranty_until", until.ToOffset(turkey).ToString("d MMMM yyyy")]
                        }
                    </p>
                    @foreach (var back in Model.WarrantyReturns)
                    {
                        <p>@H["workorder.warranty_return_html", Url.Action("Details", new { id = back.Id })!, back.Number]</p>
                    }
                    @if (Model.CanReopenUnderWarranty)
                    {
                        @* Aynı müşteri ve cihazla yeni iş emri; ikisi birbirine bağlı görünür, işçilik ücretsiz önerilir. *@
                        <a class="btn" asp-action="Warranty" asp-route-id="@Model.Id">@T["warranty.title"]</a>
                    }
                </section>
            }

            @if (Model.CanPromise)
            {
                // Takip sayfasında "tahmini teslim" olarak görünür; parça gecikince buradan değiştirilir.
                var today = DateOnly.FromDateTime(DateTimeOffset.UtcNow.ToOffset(turkey).DateTime);
                <section class="panel" aria-labelledby="promise-heading">
                    <div class="panel-head"><h2 id="promise-heading">@T["workorder.promised"]</h2></div>
                    <form method="post" asp-action="Promise" asp-route-id="@Model.Id" hx-post="@Hx("promise")" hx-target="#work-order" hx-swap="outerHTML" class="panel-body inline-form">
                        <div class="grow">
                            <label for="promise-date" class="visually-hidden">@T["workorder.promise_label"]</label>
                            <input id="promise-date" name="Date" type="date" value="@Model.PromisedDate?.ToString("yyyy-MM-dd")"
                                   min="@today.ToString("yyyy-MM-dd")" max="@today.AddDays(WorkOrder.MaxPromiseDays).ToString("yyyy-MM-dd")" />
                        </div>
                        <button type="submit" class="btn">@T["common.save"]</button>
                    </form>
                    @if (Model.PromisedDate is not null)
                    {
                        @* Boş tarih gönderen ayrı form: aynı formda iki "Date" alanı olursa ilki kazanırdı. *@
                        <form method="post" asp-action="Promise" asp-route-id="@Model.Id" hx-post="@Hx("promise")" hx-target="#work-order" hx-swap="outerHTML" class="panel-foot">
                            <button type="submit" class="btn">@T["workorder.promise_remove"]</button>
                        </form>
                    }
                </section>
            }

            <partial name="_PaymentsPanel" model="Model" />

            <section class="panel" aria-labelledby="customer-heading">
                <div class="panel-head"><h2 id="customer-heading">@T["table.customer"]</h2></div>
                <div class="panel-body">
                    <p>
                        <strong>@Model.CustomerName</strong><br />
                        <a href="tel:@Model.CustomerPhone">@Labels.Phone(Model.CustomerPhone)</a>
                        @if (Model.CustomerEmail is not null)
                        {
                            <br /><a href="mailto:@Model.CustomerEmail">@Model.CustomerEmail</a>
                        }
                    </p>
                    @if (Model.WhatsAppLink is { } whatsApp)
                    {
                        @* Mesajı Tamirhane göndermez: teknisyenin WhatsApp'ı o anki durumun hazır mesajıyla açılır, kendisi gönderir.
                           Bu bölüm her adımda yenilenir; mesaj hep güncel durumu söyler. *@
                        <a class="btn" href="@whatsApp" target="_blank" rel="noopener noreferrer" aria-describedby="whatsapp-help">
                            <svg class="icon"><use href="/img/icons.svg#i-chat" /></svg>@T["workorder.whatsapp"]
                        </a>
                        <p id="whatsapp-help" class="field-help">@T["workorder.whatsapp_help"]</p>
                    }
                    <p class="muted">
                        @T["workorder.tracking_code"] <code>@Model.TrackingCode</code>
                        @if (Model.HasPasscode)
                        {
                            <br />@T["workorder.passcode_kept"]
                        }
                    </p>
                </div>
            </section>
        </div>
    </div>

    <partial name="_QuotePanel" model="Model" />

    <div class="work-columns">
        <section class="panel" aria-labelledby="history-heading">
            <div class="panel-head"><h2 id="history-heading">@T["workorder.history"]</h2></div>
            <ol class="timeline">
                @foreach (var h in Model.History.Reverse())
                {
                    <li>
                        <strong>@T.Of(h.Status)</strong>
                        <span class="muted">@h.At.ToOffset(turkey).ToString("d MMMM HH:mm"), @(h.By ?? T["workorder.by_customer"])</span>
                        @if (h.Note is not null)
                        {
                            <span>@h.Note</span>
                        }
                    </li>
                }
            </ol>
        </section>

        <section class="panel" aria-labelledby="notes-heading">
            <div class="panel-head"><h2 id="notes-heading">@T["workorder.notes"]</h2></div>
            <div class="panel-body notes">
                <h3>@T["workorder.workshop_notes"] <span class="muted">@T["workorder.staff_only"]</span></h3>
                <form method="post" asp-action="Note" asp-route-id="@Model.Id" hx-post="@Hx("notes")" hx-target="#work-order" hx-swap="outerHTML" class="inline-form">
                    <input type="hidden" name="VisibleToCustomer" value="false" />
                    <div class="grow">
                        <label for="note-workshop" class="visually-hidden">@T["workorder.workshop_note"]</label>
                        <input id="note-workshop" name="Text" maxlength="1000" placeholder="@T["workorder.workshop_note_example"]" autocomplete="off" />
                    </div>
                    <button type="submit" class="btn">@T["common.add"]</button>
                </form>
                <ul class="note-list">
                    @foreach (var n in workshopNotes)
                    {
                        <li>@n.Text <span class="muted">@n.By, @n.At.ToOffset(turkey).ToString("d MMMM HH:mm")</span></li>
                    }
                </ul>

                <h3>@T["workorder.customer_notes"] <span class="muted">@T["workorder.on_tracking"]</span></h3>
                <form method="post" asp-action="Note" asp-route-id="@Model.Id" hx-post="@Hx("notes")" hx-target="#work-order" hx-swap="outerHTML" class="inline-form">
                    <input type="hidden" name="VisibleToCustomer" value="true" />
                    <div class="grow">
                        <label for="note-customer" class="visually-hidden">@T["workorder.customer_note"]</label>
                        <input id="note-customer" name="Text" maxlength="1000" placeholder="@T["workorder.customer_note_example"]" autocomplete="off" />
                    </div>
                    <button type="submit" class="btn">@T["common.add"]</button>
                </form>
                <ul class="note-list is-customer">
                    @foreach (var n in customerNotes)
                    {
                        <li>@n.Text <span class="muted">@n.By, @n.At.ToOffset(turkey).ToString("d MMMM HH:mm")</span></li>
                    }
                </ul>
            </div>
        </section>
    </div>
</div>
