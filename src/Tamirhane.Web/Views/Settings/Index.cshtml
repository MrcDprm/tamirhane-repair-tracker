@model SettingsPage
@{
    ViewData["Title"] = "Ayarlar";
}

<div class="page-head">
    <div>
        <h1>Ayarlar</h1>
        <p>Atölyenin adı, garanti süresi, varsayılan KDV ve şubeler.</p>
    </div>
</div>

@if (TempData["Status"] is string status)
{
    <div class="notice notice-ok" role="status">@status</div>
}
@if (TempData["Error"] is string error)
{
    <div class="notice notice-error" role="alert">@error</div>
}
<div asp-validation-summary="ModelOnly" class="notice notice-error" role="alert"></div>

<section class="panel" aria-labelledby="shop-heading">
    <div class="panel-head"><h2 id="shop-heading">Atölye</h2></div>
    <form asp-action="Update" method="post" novalidate class="panel-body">
        <div class="field-row">
            <div class="field">
                <label asp-for="Shop.Name"></label>
                <input asp-for="Shop.Name" autocomplete="organization" />
                <span asp-validation-for="Shop.Name"></span>
            </div>
            <div class="field">
                <label asp-for="Shop.Locale"></label>
                <select asp-for="Shop.Locale">
                    <option value="tr">Türkçe</option>
                    <option value="en">English</option>
                </select>
                <span asp-validation-for="Shop.Locale"></span>
            </div>
        </div>
        <div class="field-row">
            <div class="field">
                <label asp-for="Shop.WarrantyDays"></label>
                <input asp-for="Shop.WarrantyDays" type="number" min="0" max="3650" step="1" inputmode="numeric" aria-describedby="warranty-help" />
                <div id="warranty-help" class="field-help">Teslimden itibaren. 0, garanti yok demek.</div>
                <span asp-validation-for="Shop.WarrantyDays"></span>
            </div>
            <div class="field">
                <label asp-for="Shop.DefaultVatRate"></label>
                @* type="number" tarayıcıda her zaman nokta ondalıkla gönderir; değer de kültürden bağımsız yazılır. *@
                <input name="Shop.DefaultVatRate" id="Shop_DefaultVatRate" type="number" min="0" max="100" step="0.01" inputmode="decimal"
                       value="@Model.Shop.DefaultVatRate.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                       aria-describedby="vat-help" />
                <div id="vat-help" class="field-help">Yeni teklif kalemlerinde önerilen oran; kalem başına değiştirilebilir.</div>
                <span asp-validation-for="Shop.DefaultVatRate"></span>
            </div>
        </div>
        <button type="submit" class="btn btn-primary">Ayarları kaydet</button>
    </form>
</section>

<section class="panel" aria-labelledby="branches-heading">
    <div class="panel-head">
        <h2 id="branches-heading">Şubeler</h2>
        <span class="muted">Tek şuben varsa şube seçimi hiçbir ekranda çıkmaz.</span>
    </div>
    <ul class="plain-list">
        @foreach (var branch in Model.Branches)
        {
            <li>
                <form asp-action="UpdateBranch" asp-route-id="@branch.Id" method="post" class="inline-form fill">
                    <div class="grow">
                        <label class="visually-hidden" for="name-@branch.Id">Şube adı</label>
                        <input id="name-@branch.Id" name="Name" value="@branch.Name" maxlength="100" required />
                    </div>
                    <div class="wide">
                        <label class="visually-hidden" for="address-@branch.Id">Adres</label>
                        <input id="address-@branch.Id" name="Address" value="@branch.Address" maxlength="300" placeholder="Adres (isteğe bağlı)" />
                    </div>
                    <button type="submit" class="btn">Kaydet</button>
                </form>
            </li>
        }
    </ul>
    <form asp-action="AddBranch" method="post" novalidate class="panel-body inline-form">
        <div class="grow">
            <label asp-for="NewBranch.Name" class="visually-hidden"></label>
            <input asp-for="NewBranch.Name" placeholder="Yeni şubenin adı" />
            <span asp-validation-for="NewBranch.Name"></span>
        </div>
        <div class="wide">
            <label asp-for="NewBranch.Address" class="visually-hidden"></label>
            <input asp-for="NewBranch.Address" placeholder="Adres (isteğe bağlı)" />
            <span asp-validation-for="NewBranch.Address"></span>
        </div>
        <button type="submit" class="btn btn-primary"><svg class="icon"><use href="/img/icons.svg#i-plus" /></svg>Şube ekle</button>
    </form>
</section>
