@model EmailInput
@{
    ViewData["Title"] = "Yeni doğrulama linki";
}

<div class="narrow">
    <h1>Yeni doğrulama linki</h1>
    <p class="muted">Kayıtta kullandığın e-postayı yaz; hesap henüz doğrulanmadıysa yeni link gönderelim.</p>

    <form asp-action="ResendConfirmation" method="post" novalidate>
        <div class="field">
            <label asp-for="Email"></label>
            <input asp-for="Email" autocomplete="email" />
            <span asp-validation-for="Email"></span>
        </div>
        <button type="submit" class="btn btn-primary btn-block">Link gönder</button>
    </form>
</div>
