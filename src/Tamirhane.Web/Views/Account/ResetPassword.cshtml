@model ResetPasswordInput
@{
    ViewData["Title"] = "Yeni şifre belirle";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-5">
        <h1 class="h3 mb-3">Yeni şifre belirle</h1>
        <p class="text-body-secondary">Şifren değişince açık olan bütün oturumların kapanır; yeni şifrenle tekrar giriş yaparsın.</p>

        <form asp-action="ResetPassword" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <input asp-for="UserId" type="hidden" />
            <input asp-for="Token" type="hidden" />

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" aria-describedby="password-help" />
                <div id="password-help" class="form-text">En az 10 karakter; içinde harf ve rakam olsun. Uzun bir cümle de olur.</div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>
            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">Şifreyi değiştir</button>
        </form>

        <p class="mt-3"><a asp-action="ForgotPassword">Yeni bir sıfırlama linki iste</a></p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
