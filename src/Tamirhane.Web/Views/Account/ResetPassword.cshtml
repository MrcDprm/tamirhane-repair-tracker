@model ResetPasswordInput
@{
    ViewData["Title"] = T["account.reset.title"];
}

<div class="narrow">
    <h1>@T["account.reset.title"]</h1>
    <p class="muted">@T["account.reset.text"]</p>

    <form asp-action="ResetPassword" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="notice notice-error" role="alert"></div>
        <input asp-for="UserId" type="hidden" />
        <input asp-for="Token" type="hidden" />

        <div class="field">
            <label asp-for="Password"></label>
            <input asp-for="Password" autocomplete="new-password" aria-describedby="password-help" />
            <div id="password-help" class="field-help">@T["account.password.help"]</div>
            <span asp-validation-for="Password"></span>
        </div>
        <div class="field">
            <label asp-for="ConfirmPassword"></label>
            <input asp-for="ConfirmPassword" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword"></span>
        </div>

        <button type="submit" class="btn btn-primary btn-block">@T["account.reset.submit"]</button>
    </form>

    <p><a asp-action="ForgotPassword">@T["account.reset.new_link"]</a></p>
</div>
