@model LoginInput
@{
    ViewData["Title"] = "Giriş yap";
}

<div class="narrow">
    <h1>Giriş yap</h1>

    @if (ViewData["EmailNotConfirmed"] is true)
    {
        <div class="notice notice-error" role="alert">
            E-posta adresin henüz doğrulanmadı. Sana gönderdiğimiz linke tıkla ya da
            <a asp-action="ResendConfirmation">yeni bir link iste</a>.
        </div>
    }

    <form asp-action="Login" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="notice notice-error" role="alert"></div>
        <input asp-for="ReturnUrl" type="hidden" />

        <div class="field">
            <label asp-for="Email"></label>
            <input asp-for="Email" type="email" autocomplete="username" />
            <span asp-validation-for="Email"></span>
        </div>
        <div class="field">
            <label asp-for="Password"></label>
            <input asp-for="Password" autocomplete="current-password" />
            <span asp-validation-for="Password"></span>
        </div>
        <div class="check">
            <input asp-for="RememberMe" />
            <label asp-for="RememberMe"></label>
        </div>

        <button type="submit" class="btn btn-primary btn-block">Giriş yap</button>
    </form>

    <p>Hesabın yok mu? <a asp-action="Register">Atölyeni kaydet</a></p>
    <p><a asp-action="ForgotPassword">Şifremi unuttum</a></p>
    <p><a asp-action="ResendConfirmation">Doğrulama e-postası gelmedi mi?</a></p>
</div>
