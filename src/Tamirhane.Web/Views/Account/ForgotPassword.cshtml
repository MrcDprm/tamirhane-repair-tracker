@model EmailInput
@{
    ViewData["Title"] = "Şifremi unuttum";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-5">
        <h1 class="h3 mb-3">Şifremi unuttum</h1>
        <p class="text-body-secondary">Hesabının e-posta adresini yaz; yeni şifre belirlemen için bir link gönderelim.</p>

        <form asp-action="ForgotPassword" method="post" novalidate>
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100">Sıfırlama linki gönder</button>
        </form>

        <p class="mt-3"><a asp-action="Login">Giriş sayfasına dön</a></p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
