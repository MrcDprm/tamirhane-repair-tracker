@model EmailInput
@{
    ViewData["Title"] = "Şifremi unuttum";
}

<div class="narrow">
    <h1>Şifremi unuttum</h1>
    <p class="muted">Hesabının e-posta adresini yaz; yeni şifre belirlemen için bir link gönderelim.</p>

    <form asp-action="ForgotPassword" method="post" novalidate>
        <div class="field">
            <label asp-for="Email"></label>
            <input asp-for="Email" autocomplete="email" />
            <span asp-validation-for="Email"></span>
        </div>
        <button type="submit" class="btn btn-primary btn-block">Sıfırlama linki gönder</button>
    </form>

    <p><a asp-action="Login">Giriş sayfasına dön</a></p>
</div>
