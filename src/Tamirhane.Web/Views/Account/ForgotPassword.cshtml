@model EmailInput
@{
    ViewData["Title"] = T["account.forgot.title"];
}

<div class="narrow">
    <h1>@T["account.forgot.title"]</h1>
    <p class="muted">@T["account.forgot.text"]</p>

    <form asp-action="ForgotPassword" method="post" novalidate>
        <div class="field">
            <label asp-for="Email"></label>
            <input asp-for="Email" autocomplete="email" />
            <span asp-validation-for="Email"></span>
        </div>
        <button type="submit" class="btn btn-primary btn-block">@T["account.forgot.submit"]</button>
    </form>

    <p><a asp-action="Login">@T["account.back_to_login"]</a></p>
</div>
