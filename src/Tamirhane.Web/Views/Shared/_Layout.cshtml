<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Tamirhane</title>
    <link rel="icon" href="~/img/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="~/fonts/public-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @* htmx: eval kapalı ve kendi stilini eklemez (CSP'de unsafe-eval ve satır içi stil gerekmesin). *@
    <meta name="htmx-config" content='{"allowEval":false,"includeIndicatorStyles":false,"historyCacheSize":0}' />
    <script src="~/js/theme.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <a class="skip-link" href="#main">İçeriğe geç</a>
    @{
        var signedIn = User.Identity?.IsAuthenticated == true;
        var isOwner = User.IsInRole("Owner");
        // Oturumdaki görünen ad (personel kaydından); yoksa e-posta.
        var displayName = User.FindFirst("tamirhane:name")?.Value ?? User.Identity?.Name;
        var controller = ViewContext.RouteData.Values["controller"] as string;
        string? Current(string name) => controller == name ? "page" : null;
    }

    @if (signedIn)
    {
        <div class="shell">
            <aside class="side pegboard" aria-label="Atölye menüsü">
                <div class="side-head">
                    <a class="brand" asp-controller="Panel" asp-action="Index"><partial name="_BrandMark" />Tamirhane</a>
                    <button type="button" class="side-btn side-toggle" aria-expanded="false" aria-controls="side-nav">
                        <svg class="icon"><use href="/img/icons.svg#i-menu" /></svg>Menü
                    </button>
                </div>
                <nav id="side-nav" aria-label="Sayfalar">
                    <ul class="nav">
                        <li><a asp-controller="Panel" asp-action="Index" aria-current="@Current("Panel")"><svg class="icon"><use href="/img/icons.svg#i-home" /></svg>Panel</a></li>
                        <li><a asp-controller="WorkOrders" asp-action="New" aria-current="@Current("WorkOrders")"><svg class="icon"><use href="/img/icons.svg#i-tag" /></svg>Cihaz kabul</a></li>
                        @if (isOwner)
                        {
                            <li><a asp-controller="Staff" asp-action="Index" aria-current="@Current("Staff")"><svg class="icon"><use href="/img/icons.svg#i-users" /></svg>Personel</a></li>
                            <li><a asp-controller="Settings" asp-action="Index" aria-current="@Current("Settings")"><svg class="icon"><use href="/img/icons.svg#i-gear" /></svg>Ayarlar</a></li>
                        }
                    </ul>
                </nav>
                <div class="side-foot">
                    <partial name="_SideTools" />
                    <div class="side-who">
                        <strong>@displayName</strong>@User.Identity?.Name
                        <div class="side-actions">
                            <button type="button" id="theme-toggle" class="side-btn" aria-label="Koyu tema" title="Koyu tema"><svg class="icon"><use href="/img/icons.svg#i-moon" /></svg></button>
                            @* Çıkış POST'tur: bir resim etiketi ya da link ile kullanıcının oturumu dışarıdan kapatılamaz. *@
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                <button type="submit" class="side-btn"><svg class="icon"><use href="/img/icons.svg#i-logout" /></svg>Çıkış yap</button>
                            </form>
                        </div>
                    </div>
                </div>
            </aside>

            <div class="main">
                <header class="top">
                    @* Arama her ekranda; "/" aramaya, "N" kabule götürür (site.js). Arama sayfası #27'de. *@
                    <form class="search" role="search" method="get" action="/work-orders">
                        <svg class="icon"><use href="/img/icons.svg#i-search" /></svg>
                        <label for="search" class="visually-hidden">Ad, telefon, IMEI ya da iş emri no ile ara</label>
                        <input id="search" name="q" type="search" placeholder="Ad, telefon, IMEI ya da iş emri no ara" autocomplete="off"
                               aria-keyshortcuts="/" />
                        <kbd aria-hidden="true">/</kbd>
                    </form>
                    <div class="top-end">
                        @await Component.InvokeAsync("BranchSwitcher")
                        <a id="intake-link" class="btn btn-primary" asp-controller="WorkOrders" asp-action="New" aria-keyshortcuts="N">
                            <svg class="icon"><use href="/img/icons.svg#i-plus" /></svg>Cihaz kabul et
                        </a>
                    </div>
                </header>
                <main id="main" class="content">
                    @RenderBody()
                </main>
            </div>
        </div>
    }
    else
    {
        <header class="plain-top">
            <a class="brand" asp-controller="Home" asp-action="Index"><partial name="_BrandMark" />Tamirhane</a>
            <nav class="top-end" aria-label="Hesap">
                <a class="btn" asp-controller="Account" asp-action="Login">Giriş yap</a>
                <a class="btn btn-primary" asp-controller="Account" asp-action="Register">Atölyeni kaydet</a>
            </nav>
        </header>
        <main id="main" class="content">
            @RenderBody()
        </main>
    }

    <script src="~/js/vendor/motion.min.js" asp-append-version="true"></script>
    <script src="~/js/vendor/htmx.min.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/motion.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
