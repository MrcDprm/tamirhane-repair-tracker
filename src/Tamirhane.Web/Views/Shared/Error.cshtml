@model ErrorViewModel
@{
    ViewData["Title"] = "Bir hata oluştu";
}

@* Yayında ayrıntı gösterilmez; istek numarası loglardaki kaydı bulmak için. *@
<div class="narrow">
    <h1>Bir hata oluştu</h1>
    <p>İşlem tamamlanamadı. Sayfayı yenileyip tekrar dene; sorun sürerse biraz sonra yeniden dene.</p>
    @if (Model.ShowRequestId)
    {
        <p class="muted">İstek numarası: <code>@Model.RequestId</code></p>
    }
    <p><a asp-controller="Panel" asp-action="Index">Panele dön</a></p>
</div>
