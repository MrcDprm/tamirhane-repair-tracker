@model ErrorViewModel
@{
    ViewData["Title"] = T["error.title"];
}

@* Yayında ayrıntı gösterilmez; istek numarası loglardaki kaydı bulmak için. *@
<div class="narrow">
    <h1>@T["error.title"]</h1>
    <p>@T["error.text"]</p>
    @if (Model.ShowRequestId)
    {
        <p class="muted">@T["error.request_id"] <code>@Model.RequestId</code></p>
    }
    <p><a asp-controller="Panel" asp-action="Index">@T["common.back_to_panel"]</a></p>
</div>
