<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Tamirhane</title>
    <link rel="icon" href="~/img/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/print.css" asp-append-version="true" />
</head>
@* Yazdırma sayfaları: ekranda tezgâh üstünde kâğıt ve araç çubuğu; yazdırırken sadece kâğıt. Her zaman açık tema. *@
<body class="print-page">
    <div class="print-toolbar">
        <a class="btn" href="@ViewData["Back"]">İş emrine dön</a>
        <button type="button" class="btn btn-primary" data-print><svg class="icon"><use href="/img/icons.svg#i-printer" /></svg>Yazdır</button>
        <span class="muted">@ViewData["Hint"]</span>
    </div>
    @RenderBody()
    <script src="~/js/print.js" asp-append-version="true"></script>
</body>
</html>
