    <g data-anim="tool">
        @* cımbız *@
        <path d="M158 56 L148 212 M158 56 L168 212" stroke="#c9d1d6" stroke-width="5" stroke-linecap="round" fill="none" />
        <path d="M148 212 L156 224 L160 224 L168 212" fill="none" stroke="#c9d1d6" stroke-width="3" />
    </g>
    <g data-anim="tool">
        @* kargaburun *@
        <path d="M212 56 C208 108 212 148 220 184" stroke="#c8571b" stroke-width="12" stroke-linecap="round" fill="none" />
        <path d="M236 56 C240 108 236 148 228 184" stroke="#c8571b" stroke-width="12" stroke-linecap="round" fill="none" />
        <circle cx="224" cy="190" r="9" fill="#b7c0c6" />
        <path d="M218 196 L222 254 L226 254 L230 196 Z" fill="#b7c0c6" />
    </g>
    <g data-anim="tool">
        @* havya ve kablosu *@
        <path d="M298 58 C300 18 360 16 362 68 C364 138 330 188 352 258" stroke="#0e1418" stroke-width="6" fill="none" stroke-linecap="round" />
        <rect x="288" y="58" width="20" height="86" rx="7" fill="#3d4a52" stroke="#8e9aa2" stroke-width="2" />
        <rect x="295" y="144" width="6" height="64" fill="#b7c0c6" /><path d="M295 208h6l-3 22z" fill="#c8571b" />
    </g>

    <g data-anim="phone">
        <g transform="rotate(-4 432 168)">
            <rect x="384" y="56" width="108" height="204" rx="18" fill="#0e1418" stroke="#c9d1d6" stroke-width="3" />
            <rect x="392" y="72" width="92" height="172" rx="9" fill="#2f3e47" />
            <path d="M420 108 l18 22 -12 14 24 30 -8 16 20 26" stroke="#e7e9e6" stroke-width="1.6" fill="none" opacity=".7" />
            <path d="M438 130 l26 -8 M426 144 l-22 10" stroke="#e7e9e6" stroke-width="1.2" fill="none" opacity=".5" />
        </g>
    </g>

    @* ip telefondan etiketin deliğine; etiket ipin ucunda sallanır *@
    <path d="M490 110 C 504 100, 508 124, 516 142" stroke="#e6d3a8" stroke-width="2.5" fill="none" />
    <g data-anim="tag">
        <g transform="translate(-14 -4) rotate(6 560 200)">
            <path d="M512 148 L530 130 H608 V266 H530 L512 248 Z" fill="#e6d3a8" />
            <circle cx="530" cy="158" r="7" fill="#26323a" stroke="#c9b27e" stroke-width="3" />
            <text x="540" y="188" font-family="Barlow Semi Condensed, sans-serif" font-weight="700" font-size="15" fill="#3b3220">2026-0042</text>
            <path d="M542 200h54M542 212h40" stroke="#9c8a62" stroke-width="2" />
            <g data-anim="stamp" transform="rotate(-8 572 242)">
                <rect x="540" y="228" width="64" height="26" rx="4" fill="none" stroke="#2b44a8" stroke-width="2.5" />
                <text x="572" y="246" text-anchor="middle" font-family="Barlow Semi Condensed, sans-serif" font-weight="700" font-size="13" letter-spacing="1" fill="#2b44a8">ONARIMDA</text>
            </g>
        </g>
    </g>

    @* tezgâh kenarı *@
    <rect x="-20" y="292" width="680" height="38" fill="#c9b27e" /><rect x="-20" y="292" width="680" height="6" fill="#e6d3a8" />
