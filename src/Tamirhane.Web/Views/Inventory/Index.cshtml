@model InventoryPage
@{
    ViewData["Title"] = T["nav.inventory"];
    var list = Model.List;
    var isOwner = User.IsInRole("Owner");
}

<div class="page-head">
    <div>
        <h1>@T["nav.inventory"]</h1>
        <p>@T["inventory.text"]</p>
    </div>
</div>

@* Form hataları herkese görünür yerde (teknisyen elle gönderirse de neden reddedildiğini görür). *@
<div asp-validation-summary="ModelOnly" class="notice notice-error" role="alert"></div>

@* Panoya asılı iki etiket: parça çeşidi ve kritik stoktakiler (tıklayınca liste süzülür). *@
<div class="hang-tags hang-tags-2">
    <a class="hang-tag" asp-action="Index"><strong>@list.ActiveCount</strong>@T["inventory.kinds"]</a>
    <a class="hang-tag@(list.LowCount > 0 ? " is-warn" : "")" asp-action="Index" asp-route-low="true"><strong>@list.LowCount</strong>@T["inventory.low_count"]</a>
</div>

<section class="panel" aria-labelledby="parts-heading">
    <div class="panel-head">
        <h2 id="parts-heading">@T[Model.LowOnly ? "inventory.low_parts" : "inventory.parts"]</h2>
        <form method="get" asp-action="Index" class="inline-form" role="search">
            <label for="part-search" class="visually-hidden">@T["inventory.search_label"]</label>
            <input id="part-search" name="q" type="search" value="@Model.Query" placeholder="@T["inventory.search_placeholder"]" autocomplete="off" />
            @if (Model.LowOnly)
            {
                <input type="hidden" name="low" value="true" />
            }
            <button type="submit" class="btn"><svg class="icon"><use href="/img/icons.svg#i-search" /></svg>@T["list.search"]</button>
        </form>
    </div>

    @if (list.Parts.Count == 0)
    {
        <p class="panel-body muted">
            @(Model.Query is { Length: > 0 } ? T["inventory.no_match", Model.Query]
                : T[Model.LowOnly ? "inventory.no_low" : "inventory.empty"])
        </p>
    }
    else
    {
        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th scope="col">@T["field.sku"]</th>
                        <th scope="col">@T["quote.part"]</th>
                        <th scope="col" class="num">@T["nav.inventory"]</th>
                        <th scope="col" class="num">@T["field.critical_level"]</th>
                        <th scope="col" class="num">@T["field.sale_price"]</th>
                        @if (isOwner)
                        {
                            <th scope="col" class="num">@T["field.cost_price"]</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var part in list.Parts)
                    {
                        <tr class="@(part.IsActive ? "" : "is-retired")">
                            <td><code>@part.Sku</code></td>
                            <td>
                                <a asp-action="Part" asp-route-id="@part.Id">@part.Name</a>
                                @if (!part.IsActive)
                                {
                                    <span class="muted">@T["inventory.retired_note"]</span>
                                }
                            </td>
                            <td class="num">
                                @if (part.IsLow)
                                {
                                    <span class="stamp stamp-sm stamp-warn">@T["inventory.critical"]</span>
                                }
                                <strong class="@(part.IsLow ? "warn-text" : "")">@part.Quantity</strong>
                            </td>
                            <td class="num">@(part.CriticalLevel == 0 ? "" : part.CriticalLevel)</td>
                            <td class="num">@part.SalePrice.ToString("C")</td>
                            @if (isOwner)
                            {
                                <td class="num muted">@part.CostPrice?.ToString("C")</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    <p class="panel-foot">
        @if (Model.IncludeInactive)
        {
            <a asp-action="Index">@T["inventory.hide_retired"]</a>
        }
        else
        {
            <a asp-action="Index" asp-route-inactive="true">@T["inventory.show_retired"]</a>
        }
    </p>
</section>

@if (isOwner)
{
    <section class="panel" aria-labelledby="new-part-heading">
        <div class="panel-head"><h2 id="new-part-heading">@T["inventory.new_part"]</h2></div>
        <form method="post" asp-action="Add" novalidate class="panel-body">
            <div class="field-row">
                <div class="field">
                    <label asp-for="NewPart.Sku"></label>
                    <input asp-for="NewPart.Sku" class="code" placeholder="@T["inventory.sku_example"]" autocomplete="off" />
                    <span asp-validation-for="NewPart.Sku"></span>
                </div>
                <div class="field">
                    <label asp-for="NewPart.Name"></label>
                    <input asp-for="NewPart.Name" placeholder="@T["inventory.name_example"]" autocomplete="off" />
                    <span asp-validation-for="NewPart.Name"></span>
                </div>
            </div>
            <div class="field-row">
                <div class="field">
                    <label asp-for="NewPart.CostPrice"></label>
                    <input name="NewPart.CostPrice" id="NewPart_CostPrice" type="number" min="0" step="0.01" inputmode="decimal"
                           value="@(Model.NewPart.CostPrice == 0 ? "" : Model.NewPart.CostPrice.ToString(System.Globalization.CultureInfo.InvariantCulture))" />
                </div>
                <div class="field">
                    <label asp-for="NewPart.SalePrice"></label>
                    <input name="NewPart.SalePrice" id="NewPart_SalePrice" type="number" min="0" step="0.01" inputmode="decimal"
                           value="@(Model.NewPart.SalePrice == 0 ? "" : Model.NewPart.SalePrice.ToString(System.Globalization.CultureInfo.InvariantCulture))" />
                    <span asp-validation-for="NewPart.SalePrice"></span>
                </div>
                <div class="field">
                    <label asp-for="NewPart.CriticalLevel"></label>
                    <input asp-for="NewPart.CriticalLevel" type="number" min="0" step="1" inputmode="numeric" aria-describedby="critical-help" />
                    <div id="critical-help" class="field-help">@T["inventory.critical_help"]</div>
                    <span asp-validation-for="NewPart.CriticalLevel"></span>
                </div>
                <div class="field">
                    <label asp-for="NewPart.OpeningQuantity"></label>
                    <input asp-for="NewPart.OpeningQuantity" type="number" min="0" step="1" inputmode="numeric" />
                    <span asp-validation-for="NewPart.OpeningQuantity"></span>
                </div>
            </div>
            <button type="submit" class="btn btn-primary"><svg class="icon"><use href="/img/icons.svg#i-plus" /></svg>@T["quote.add_part_submit"]</button>
        </form>
    </section>
}
