@using Tamirhane.Domain.Shops
@model StaffPage
@{
    ViewData["Title"] = T["nav.staff"];
    var turkey = TimeSpan.FromHours(3);
}

<div class="page-head">
    <div>
        <h1>@T["nav.staff"]</h1>
        <p>@T["staff.text"]</p>
    </div>
</div>

@if (TempData["Status"] is string status)
{
    <div class="notice notice-ok" role="status">@status</div>
}
@if (TempData["Error"] is string error)
{
    <div class="notice notice-error" role="alert">@error</div>
}

<section class="panel" aria-labelledby="members-heading">
    <div class="panel-head"><h2 id="members-heading">@T["staff.members"]</h2></div>
    <div class="table-wrap">
        <table class="data-table">
            <thead>
                <tr><th scope="col">@T["staff.name"]</th><th scope="col">@T["staff.role"]</th><th scope="col"><span class="visually-hidden">@T["quote.actions"]</span></th></tr>
            </thead>
            <tbody>
                @foreach (var member in Model.Overview.Members)
                {
                    <tr>
                        <td>
                            <strong>@member.DisplayName</strong>
                            @if (member.IsYou)
                            {
                                <span class="muted">@T["staff.you"]</span>
                            }
                        </td>
                        <td><span class="stamp stamp-sm@(member.Role == StaffRole.Owner ? "" : " stamp-ok")">@T[member.Role == StaffRole.Owner ? "staff.owner" : "staff.technician"]</span></td>
                        <td class="actions">
                            @if (member.Role != StaffRole.Owner)
                            {
                                @* Onay metni data özelliğinde: ad JavaScript içine yazılmaz, Razor onu HTML olarak kaçışlar. *@
                                <form asp-action="Remove" asp-route-id="@member.Id" method="post"
                                      data-confirm="@T["staff.remove_confirm", member.DisplayName]">
                                    <button type="submit" class="btn btn-danger">@T["quote.remove"]</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

<section class="panel" aria-labelledby="invite-heading">
    <div class="panel-head"><h2 id="invite-heading">@T["staff.invite"]</h2></div>
    <div class="panel-body">
        <p class="muted">@T["staff.invite_text"]</p>
        <form asp-action="Invite" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="notice notice-error" role="alert"></div>
            <div class="inline-form">
                <div class="wide">
                    <label asp-for="Invite.Email" class="visually-hidden"></label>
                    <input asp-for="Invite.Email" placeholder="@T["staff.invite_example"]" autocomplete="off" />
                    <span asp-validation-for="Invite.Email"></span>
                </div>
                <button type="submit" class="btn btn-primary">@T["staff.invite_submit"]</button>
            </div>
        </form>
    </div>
</section>

@if (Model.Overview.Invitations.Count > 0)
{
    <section class="panel" aria-labelledby="pending-heading">
        <div class="panel-head"><h2 id="pending-heading">@T["staff.pending"]</h2></div>
        <ul class="plain-list">
            @foreach (var invitation in Model.Overview.Invitations)
            {
                <li>
                    <span>
                        <strong>@invitation.Email</strong>
                        <span class="muted">, @T["staff.valid_until", invitation.ExpiresAt.ToOffset(turkey).ToString("d MMMM HH:mm")]</span>
                    </span>
                    <form asp-action="Revoke" asp-route-id="@invitation.Id" method="post">
                        <button type="submit" class="btn">@T["staff.revoke"]</button>
                    </form>
                </li>
            }
        </ul>
    </section>
}
