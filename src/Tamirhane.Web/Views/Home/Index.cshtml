@{
    Layout = "_AuthLayout";
    ViewData["Title"] = T["home.title"];
}

@* Asıl tanıtım sayfası #37'de; şimdilik pano çizimiyle kısa bir giriş. *@
<div class="narrow">
    @if (TempData["Error"] is string error)
    {
        <div class="notice notice-error" role="alert">@error</div>
    }
    <h1>@T["home.heading"]</h1>
    <p>@T["home.text"]</p>
    <div class="inline-form">
        <a class="btn btn-primary" asp-controller="Account" asp-action="Register">@T["account.register.title"]</a>
        <form asp-controller="Demo" asp-action="Start" method="post">
            <button type="submit" class="btn">@T["demo.try"]</button>
        </form>
        <a class="btn" asp-controller="Account" asp-action="Login">@T["account.login.title"]</a>
    </div>
    <p class="muted">@T["demo.try_help"]</p>
</div>
