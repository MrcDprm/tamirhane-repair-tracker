@{
    Layout = "_AuthLayout";
    ViewData["Title"] = T["home.title"];
}

@* Asıl tanıtım sayfası #37'de; şimdilik pano çizimiyle kısa bir giriş. *@
<div class="narrow">
    <h1>@T["home.heading"]</h1>
    <p>@T["home.text"]</p>
    <p class="inline-form">
        <a class="btn btn-primary" asp-controller="Account" asp-action="Register">@T["account.register.title"]</a>
        <a class="btn" asp-controller="Account" asp-action="Login">@T["account.login.title"]</a>
    </p>
</div>
