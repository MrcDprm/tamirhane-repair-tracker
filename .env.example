# Tamirhane ortam değişkenleri. Bu dosyayı ".env" adıyla kopyalayıp değerleri doldurun;
# ".env" depoya girmez (.gitignore). Production'da değerler Render ortam değişkenlerindedir.

# PostgreSQL bağlantısı. URL (Neon/Render) ya da Npgsql biçimi kabul edilir.
DATABASE_URL=postgresql://tamirhane:tamirhane@localhost:5432/tamirhane

# E-posta linklerinin başı (doğrulama, şifre sıfırlama). İsteğin Host başlığı kullanılmaz.
# Geliştirmede boş bırakılabilir (https://localhost:7071). Production: https://tamirhane.miracdeprem.com gibi.
PUBLIC_ORIGIN=

# Resend API anahtarı (https://resend.com, ücretsiz katman). Geliştirmede boşsa e-postalar konsola yazılır;
# production'da zorunlu.
RESEND_API_KEY=

# Gönderen. Alan adı Resend'de doğrulanmış olmalı.
EMAIL_FROM=Tamirhane <tamirhane@miracdeprem.com>

# İstemcinin gerçek IP'sini taşıyan başlık (hesap formlarındaki rate limit için). Sadece uygulama Cloudflare'in
# arkasındaysa CF-Connecting-IP yazın; boşsa bağlantının IP'si kullanılır.
CLIENT_IP_HEADER=
